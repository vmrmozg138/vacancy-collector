# Скопируйте в .env и при необходимости поправьте.

# Куда пишем данные:
#   SQLite (быстрый локальный запуск)   sqlite:///collector.db
#   PostgreSQL (рабочий вариант)        postgresql+psycopg://collector:collector@localhost:5433/collector
#
# PostgreSQL поднимается из docker-compose.yml:  docker compose up -d
# Наружу он отдан на порт 5433, потому что 5432 на этой машине занят локальным
# PostgreSQL 18 (служба postgresql-x64-18). Код при смене базы не меняется —
# отличается только эта строка.
COLLECTOR_DB_URL=sqlite:///collector.db

# User-Agent с контактом: требование этичного парсинга и условия большинства API.
COLLECTOR_USER_AGENT=OpenDataCollector/0.1 (+https://github.com/vmrmozg138)

COLLECTOR_TIMEOUT=30
# Пауза между запросами, секунды. Не даём нагрузку на чужой сервер.
COLLECTOR_DELAY=0.5
COLLECTOR_MAX_RETRIES=4
COLLECTOR_LOG_FILE=collector.log

# Куда Playwright складывает браузеры. Если пусто — берётся папка проекта .pw-browsers,
# если она существует; иначе стандартный путь Playwright в профиле пользователя.
# PLAYWRIGHT_BROWSERS_PATH=.pw-browsers
