# Скопируйте в .env и при необходимости поправьте.

# Куда пишем данные:
#   SQLite (быстрый локальный запуск)   sqlite:///collector.db
#   PostgreSQL (рабочий вариант)        postgresql+psycopg://collector:collector@localhost:5432/collector
COLLECTOR_DB_URL=sqlite:///collector.db

# User-Agent с контактом: требование этичного парсинга и условия большинства API.
COLLECTOR_USER_AGENT=OpenDataCollector/0.1 (+https://github.com/vmrmozg138)

COLLECTOR_TIMEOUT=30
# Пауза между запросами, секунды. Не даём нагрузку на чужой сервер.
COLLECTOR_DELAY=0.5
COLLECTOR_MAX_RETRIES=4
COLLECTOR_LOG_FILE=collector.log
