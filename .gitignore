.venv/
__pycache__/
*.pyc
.idea/
.env
*.db
*.log
.pytest_cache/
.pytest-tmp/
.runtime/
pytest-cache-files-*/

# Профиль Chromium: создаётся при запуске браузера из проекта.
.chrome-profile/

# Браузеры Playwright: скачиваются локально (~150 МБ), в репозитории им не место.
.pw-browsers/
.tmp/

# Локальный кэш сырых ответов источников: может содержать контакты работодателей,
# в репозиторий не попадает никогда (см. README, раздел про этику).
var/
exports/
